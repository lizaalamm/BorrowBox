# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Authentication
# Required when NODE_ENV=production and must be at least 32 characters long.
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-characters

# Comma separated list of extra origins allowed to call the API.
# The local dev and preview hosts are always allowed outside production.
API_ALLOWED_ORIGINS=

# Optional override for the JSON storage location.
# DB_PATH=./data/db.json
